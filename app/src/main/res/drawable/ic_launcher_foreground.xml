<?xml version="1.0" encoding="utf-8"?>
<!-- Download arrow dropping into a tray: the app saves any supported file
     (image, video, PDF), not only pictures. Drawn inside the adaptive icon's
     66 dp safe zone (21-87) of the 108 dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Arrow -->
    <path
        android:pathData="M54,30 V62 M42,50 L54,62 L66,50"
        android:strokeWidth="6"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Tray -->
    <path
        android:pathData="M33,62 V72 A5,5 0 0 0 38,77 H70 A5,5 0 0 0 75,72 V62"
        android:strokeWidth="6"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
