<?xml version="1.0" encoding="utf-8"?>
<!-- The app keeps no data of its own (saved files live in Download/, outside
     the app), so nothing is backed up or moved to a new device. Android 12+
     reads this file; android:allowBackup="false" covers Android 10 and 11. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
